    "next": "s58",
    "js": "var quiz_number = getContactVariable(\"Квест\"); // \"Квест 1\"\nvar currentNumber = parseInt(quiz_number.replace(/\\D/g, ''));\nvar newQuizNumber = \"Квест \" + (currentNumber + 1);\nsetContactVariable(\"Квест\", newQuizNumber);"
  },
  {
    "id": "s24",
    "type": "javascript",
    "name": "Проверка первой попытки (теги)",
    "js": "// 1. Номер текущего квеста\nvar quiz_number = getContactVariable(\"Квест\");\nif (!quiz_number) {\n    goToBlock(BLOCK_REPEAT); // ошибка\n} else if (hasContactTag(quiz_number)) {\n    goToBlock(BLOCK_REPEAT); // квест уже пройден — в рейтинг не идёт\n} else {\n    setContactTag(quiz_number); // помечаем первую попытку\n    goToBlock(BLOCK_FIRST);     // пишем в first_rating\n}"
  },
