        },
        {
          "json_key": "data.{{ $счетчик }}.po",
          "variable": "по"
        },
        {
          "json_key": "data.{{ $счетчик }}.varianty",
          "variable": "варианты"
        },
        {
          "json_key": "data.{{ $счетчик }}.otvet5",
          "variable": "ответ5"
