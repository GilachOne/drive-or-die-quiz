      {
        "text": "Сертификаты",
        "type": "inline_query_current"
      }
    ]
  },
  {
    "id": "s8",
    "type": "list_read_item",
    "raw": {
      "list_read_item": {
        "title_field_id": "nazvanie",
        "description_field_id": "opisanie",
        "image_field_id": "foto",
        "filters": [
          {
            "id": "nazvanie",
            "term": "=",
            "value": "{{ $Товар }}"
          }
        ],
        "templates": [
          {
            "type": "image",
            "value": "foto"
          },
          {
            "type": "template",
            "value": "*{{ nazvanie }}*\n\n{{ opisanie }}\n\nЦена: {{ drc_cost }},00 DRC"
          }
        ],
        "is_shop": true,
        "basket_template": "Добавить в корзину",
        "price_field_id": "cena"
      }
    },
    "buttons": [
      {
        "text": "Перейти в корзину",
        "next": "s12"
      },
      {
        "text": "Каталог",
        "type": "inline_query_current"
      }
    ]
  },
  {
    "id": "s9",
    "type": "inline_telegram",
    "next": "s8",
    "raw": {
      "inline_telegram": {
        "tag_name": "merch",
        "title_field_slug": "nazvanie",
        "description_field_slug": "drc_cost",
        "img_field_slug": "foto"
      }
    },
